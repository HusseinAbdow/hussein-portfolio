# Resend (existing — contact form)
RESEND_API_KEY=

# Supabase (project settings → API)
# URL and anon key are public by design (used in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Your numeric GitHub user ID (not username) — gates the future admin flow.
# Find it at https://api.github.com/users/<your-username> → "id"
ADMIN_GITHUB_USER_ID=
